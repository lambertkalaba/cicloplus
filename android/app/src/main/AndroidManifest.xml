<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- NOTA: no declaramos READ_MEDIA_IMAGES ni READ_EXTERNAL_STORAGE.
         La función "Adjuntar foto" usa `file_picker`, que abre el selector
         de archivos del propio sistema (Storage Access Framework); ese
         selector no necesita permisos de almacenamiento en ninguna
         versión de Android. Declarar esos permisos (aunque limitados con
         maxSdkVersion) incumple la política de Google Play de usar
         selectores del sistema en vez de pedir acceso general a medios. -->

    <!-- Cámara para el chat con el socio/pareja (adjuntar una foto tomada
         en el momento, no solo elegida de la galería) — usada por
         image_picker en partner_chat_screen.dart. -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Necesario en Android 12+ (API 31+) para poder programar alarmas
         exactas (AndroidScheduleMode.exactAllowWhileIdle en
         reminder_service.dart y daily_notification_service.dart) — sin
         esto, zonedSchedule lanza PlatformException
         "exact_alarms_not_permitted" al intentar activar cualquier
         recordatorio (Periodo, Ovulación, Días fértiles, anticonceptivo o
         registro diario). SCHEDULE_EXACT_ALARM se concede automáticamente
         al instalar para apps de calendario/alarma; no requiere que la
         usuaria lo apruebe manualmente en un diálogo del sistema. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- CicloPlus en Android no usa Health Connect: se eliminan aquí los
         permisos de salud que pudiera aportar algún plugin al fusionar
         manifiestos, para no tener que declarar funciones de salud en Play. -->
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_HISTORY" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_HEALTH_DATA_IN_BACKGROUND" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_WEIGHT" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_WEIGHT" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_SLEEP" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_SLEEP" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_BODY_TEMPERATURE" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_BODY_TEMPERATURE" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_MENSTRUATION" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_MENSTRUATION" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_HEART_RATE_VARIABILITY" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE_VARIABILITY" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_RESTING_HEART_RATE" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_RESTING_HEART_RATE" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_HEART_RATE" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_STEPS" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_STEPS" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_ACTIVE_CALORIES_BURNED" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_DISTANCE" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_DISTANCE" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_EXERCISE" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_EXERCISE" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_BLOOD_PRESSURE" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_PRESSURE" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_BLOOD_GLUCOSE" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_BLOOD_GLUCOSE" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_OXYGEN_SATURATION" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_OXYGEN_SATURATION" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_HEIGHT" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_HEIGHT" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_TOTAL_CALORIES_BURNED" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_TOTAL_CALORIES_BURNED" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_BODY_FAT" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_BODY_FAT" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_HYDRATION" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_HYDRATION" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_NUTRITION" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_NUTRITION" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_RESPIRATORY_RATE" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_RESPIRATORY_RATE" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_BASAL_METABOLIC_RATE" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_BASAL_METABOLIC_RATE" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_OVULATION_TEST" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_OVULATION_TEST" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_CERVICAL_MUCUS" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_CERVICAL_MUCUS" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_INTERMENSTRUAL_BLEEDING" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_INTERMENSTRUAL_BLEEDING" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.READ_SEXUAL_ACTIVITY" tools:node="remove"/>
    <uses-permission android:name="android.permission.health.WRITE_SEXUAL_ACTIVITY" tools:node="remove"/>

    <application
        android:label="cicloplus_app"
        android:name="${applicationName}"
        android:icon="@mipmap/launcher_icon">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Enlace de invitación al vincular con un socio/pareja (ver
                 DeepLinkService e InvitePartnerScreen): al escanear con la
                 cámara NORMAL del móvil (no una cámara dentro de la app)
                 el QR "cicloplus://link?code=..." que genera esa pantalla,
                 Android abre CicloPlus directamente aquí con el código ya
                 listo para pegar — solo falta tocar "Vincularme". Es un
                 esquema propio (no un enlace https verificado con un
                 dominio), así que solo funciona si CicloPlus ya está
                 instalada en el móvil que escanea. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="cicloplus" android:host="link" />
            </intent-filter>
        </activity>

        <!-- Widget real de pantalla de inicio (fase 8, Configuración >
             Widget) — ver CicloPlusWidgetProvider.kt, actualizado desde
             Dart vía HomeWidgetService/MainTabScreen._syncHomeWidget. -->
        <receiver
            android:name=".CicloPlusWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/cicloplus_widget_info" />
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <!-- Requerido en Android 11+ (API 30+) para que url_launcher pueda
             encontrar el navegador del dispositivo y abrir enlaces https
             (por ejemplo, "Política de privacidad" y "Términos de uso" en
             Configuración): sin esta declaración de visibilidad de
             paquete, launchUrl con LaunchMode.externalApplication no
             encuentra ninguna actividad que resuelva el intent y devuelve
             false silenciosamente — el botón parece no hacer nada. -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="http" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
